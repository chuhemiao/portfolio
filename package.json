{
  "name": "porfolio",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "content:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.mjs",
    "assets:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-static-assets.mjs",
    "content:prepare": "pnpm content:build && pnpm assets:build",
    "predev": "pnpm content:prepare",
    "dev": "next dev",
    "prebuild": "pnpm content:prepare",
    "build": "next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prune-segment-cache.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/emit-legacy-blog-redirects.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n.mjs",
    "start": "npx --yes serve out",
    "fix": "pnpm dlx fix-react2shell-next@latest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:research:depth": "node scripts/audit-research-depth.mjs",
    "check:research:logos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-research-logos.mjs",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-check.mjs",
    "content:translate:research": "node scripts/translate-research-content.mjs",
    "content:organize": "node scripts/content-organize.mjs",
    "new:post": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/new-post.mjs",
    "quick:add": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/quick-add-content.mjs",
    "seed:research:candidates": "node scripts/seed-research-candidates.mjs",
    "status:research:run": "node scripts/research-run-status.mjs",
    "sync:oscillator": "node --experimental-strip-types scripts/sync-oscillator-snapshot.mjs",
    "sync:watch": "node --experimental-strip-types scripts/sync-watch-snapshot.mjs",
    "sync:research": "node scripts/sync-research.mjs",
    "sync:research:registry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-research-registry.mjs",
    "sync:research:logos": "node scripts/sync-research-logos.mjs",
    "sync:instruments": "node scripts/sync-instruments.mjs",
    "stats:group": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instrument-group-stats.mjs",
    "sync:telegram": "node scripts/sync-telegram.js",
    "translate:thoughts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/translate-thoughts.mjs",
    "test:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/i18n.test.mjs scripts/lib/content/tests/multilingual.test.mjs src/lib/post-locale-selection.test.mjs src/data/research-localization.test.mjs scripts/lib/translations/research-template.test.mjs src/lib/thought-localization.test.mjs src/lib/weekly-localization.test.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "test:markets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/oscillator-helpers.test.mjs src/lib/oscillator-snapshot.test.mjs src/lib/watch-client-data.test.mjs src/lib/btc-score-client-data.test.mjs scripts/sync-watch-snapshot.test.mjs",
    "check:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.3",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fix-react2shell-next": "^1.1.4",
    "framer-motion": "^12.24.12",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "motion": "^12.7.4",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.6",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
