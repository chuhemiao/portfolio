[
  {
    "scene": 1,
    "source_segment": 0,
    "start": 0.396667,
    "end": 3.976667,
    "text": "据链上分析，10月29日晚，币安一个热钱包被清空。",
    "start_ms": 397,
    "end_ms": 3977
  },
  {
    "scene": 1,
    "source_segment": 1,
    "start": 4.178764,
    "end": 7.118764,
    "text": "独立核算，外流56.43亿美元。",
    "start_ms": 4179,
    "end_ms": 7119
  },
  {
    "scene": 1,
    "source_segment": 2,
    "start": 7.2851360000000005,
    "end": 10.4825535,
    "text": "注意，这是外流，不是已确认的净损失。",
    "start_ms": 7285,
    "end_ms": 10483
  },
  {
    "scene": 1,
    "source_segment": 3,
    "start": 10.4825535,
    "end": 13.7598835,
    "text": "资金离场八分钟后，才出现公开预警。",
    "start_ms": 10483,
    "end_ms": 13760
  },
  {
    "scene": 1,
    "source_segment": 4,
    "start": 13.7598835,
    "end": 16.838750500000003,
    "text": "而关键线索，是一条授权签名。",
    "start_ms": 13760,
    "end_ms": 16839
  },
  {
    "scene": 1,
    "source_segment": 5,
    "start": 16.838750500000003,
    "end": 20.577705,
    "text": "被讨论的，是谁有权让钱包执行代码。",
    "start_ms": 16839,
    "end_ms": 20578
  },
  {
    "scene": 1,
    "source_segment": 6,
    "start": 20.73557,
    "end": 22.79557,
    "text": "根因仍待官方确认。",
    "start_ms": 20736,
    "end_ms": 22796
  },
  {
    "scene": 2,
    "source_segment": 0,
    "start": 23.73,
    "end": 29.19,
    "text": "先看准备过程。链上记录显示，\n这是一场铺了将近18小时的行动。",
    "start_ms": 23730,
    "end_ms": 29190
  },
  {
    "scene": 2,
    "source_segment": 1,
    "start": 29.57,
    "end": 33.67,
    "text": "凌晨2点28分，攻击者部署第一个测试合约。",
    "start_ms": 29570,
    "end_ms": 33670
  },
  {
    "scene": 2,
    "source_segment": 2,
    "start": 33.886666999999996,
    "end": 36.866667,
    "text": "下午1点51分和4点20分，",
    "start_ms": 33887,
    "end_ms": 36867
  },
  {
    "scene": 2,
    "source_segment": 2,
    "start": 37.146666999999994,
    "end": 41.166667000000004,
    "text": "他在自己控制的三个钱包上，演练了委托和扫荡。",
    "start_ms": 37147,
    "end_ms": 41167
  },
  {
    "scene": 2,
    "source_segment": 3,
    "start": 41.519999999999996,
    "end": 45.1,
    "text": "下午3点59分，最终合约部署完成；",
    "start_ms": 41520,
    "end_ms": 45100
  },
  {
    "scene": 2,
    "source_segment": 3,
    "start": 45.72,
    "end": 47.805,
    "text": "4点47分，彩排结束。",
    "start_ms": 45720,
    "end_ms": 47805
  },
  {
    "scene": 2,
    "source_segment": 4,
    "start": 47.805,
    "end": 52.33,
    "text": "但他又等了约三个半小时，才对目标动手。",
    "start_ms": 47805,
    "end_ms": 52330
  },
  {
    "scene": 2,
    "source_segment": 5,
    "start": 52.669999999999995,
    "end": 56.3516665,
    "text": "这条时间线的重点是：在碰目标之前，",
    "start_ms": 52670,
    "end_ms": 56352
  },
  {
    "scene": 2,
    "source_segment": 6,
    "start": 56.3516665,
    "end": 60.613333000000004,
    "text": "整条路径已经在他自己的账户上跑通过。",
    "start_ms": 56352,
    "end_ms": 60613
  },
  {
    "scene": 3,
    "source_segment": 0,
    "start": 65.39666700000001,
    "end": 68.41666699999999,
    "text": "这条签名授权的，是账户代码指向谁。",
    "start_ms": 65397,
    "end_ms": 68417
  },
  {
    "scene": 3,
    "source_segment": 1,
    "start": 68.734003,
    "end": 74.034003,
    "text": "普通交易签名会绑定收款地址、\n金额、调用数据和gas上限。",
    "start_ms": 68734,
    "end_ms": 74034
  },
  {
    "scene": 3,
    "source_segment": 2,
    "start": 74.243956,
    "end": 77.12395599999999,
    "text": "EIP-7702只绑定三个字段：",
    "start_ms": 74244,
    "end_ms": 77124
  },
  {
    "scene": 3,
    "source_segment": 3,
    "start": 77.312374,
    "end": 81.012374,
    "text": "链标识、目标合约地址，以及账户nonce。",
    "start_ms": 77312,
    "end_ms": 81012
  },
  {
    "scene": 3,
    "source_segment": 4,
    "start": 81.222131,
    "end": 83.36668850000001,
    "text": "它不承诺合约会做什么，",
    "start_ms": 81222,
    "end_ms": 83367
  },
  {
    "scene": 3,
    "source_segment": 5,
    "start": 83.36668850000001,
    "end": 85.93124599999999,
    "text": "也不保证代码以后不变。",
    "start_ms": 83367,
    "end_ms": 85931
  },
  {
    "scene": 3,
    "source_segment": 6,
    "start": 86.517626,
    "end": 90.25053,
    "text": "签名对象还不是EIP-712结构化数据，",
    "start_ms": 86518,
    "end_ms": 90251
  },
  {
    "scene": 3,
    "source_segment": 7,
    "start": 90.25053,
    "end": 92.807196,
    "text": "缺少可读字段名和语义。",
    "start_ms": 90251,
    "end_ms": 92807
  },
  {
    "scene": 3,
    "source_segment": 8,
    "start": 92.807196,
    "end": 96.4438615,
    "text": "硬件钱包因此可能只显示哈希，",
    "start_ms": 92807,
    "end_ms": 96444
  },
  {
    "scene": 3,
    "source_segment": 9,
    "start": 96.4438615,
    "end": 98.907024,
    "text": "而不是清楚的委托说明。",
    "start_ms": 96444,
    "end_ms": 98907
  },
  {
    "scene": 3,
    "source_segment": 10,
    "start": 98.907024,
    "end": 102.10448550000001,
    "text": "这批授权的链标识全是1，",
    "start_ms": 98907,
    "end_ms": 102104
  },
  {
    "scene": 3,
    "source_segment": 11,
    "start": 102.10448550000001,
    "end": 104.1662455,
    "text": "只覆盖以太坊主网，",
    "start_ms": 102104,
    "end_ms": 104166
  },
  {
    "scene": 3,
    "source_segment": 12,
    "start": 104.1662455,
    "end": 107.700803,
    "text": "不能据此解释其他链的资产外流。",
    "start_ms": 104166,
    "end_ms": 107701
  },
  {
    "scene": 4,
    "source_segment": 0,
    "start": 108.73,
    "end": 110.77,
    "text": "授权和清空，是两笔交易。",
    "start_ms": 108730,
    "end_ms": 110770
  },
  {
    "scene": 4,
    "source_segment": 1,
    "start": 110.92808500000001,
    "end": 114.868085,
    "text": "授权在20:20:59上链，是Type-4交易。",
    "start_ms": 110928,
    "end_ms": 114868
  },
  {
    "scene": 4,
    "source_segment": 2,
    "start": 115.062594,
    "end": 118.0431655,
    "text": "input为空，授权藏在授权列表里，",
    "start_ms": 115063,
    "end_ms": 118043
  },
  {
    "scene": 4,
    "source_segment": 3,
    "start": 118.0431655,
    "end": 120.76373699999999,
    "text": "只查调用数据的监控会漏看。",
    "start_ms": 118043,
    "end_ms": 120764
  },
  {
    "scene": 4,
    "source_segment": 4,
    "start": 120.942086,
    "end": 123.996981,
    "text": "清空发生在20:24:23，",
    "start_ms": 120942,
    "end_ms": 123997
  },
  {
    "scene": 4,
    "source_segment": 5,
    "start": 123.996981,
    "end": 127.031876,
    "text": "相隔17个区块、3分24秒。",
    "start_ms": 123997,
    "end_ms": 127032
  },
  {
    "scene": 4,
    "source_segment": 6,
    "start": 127.41896,
    "end": 129.695819,
    "text": "Type-4在内存池公开可见，",
    "start_ms": 127419,
    "end_ms": 129696
  },
  {
    "scene": 4,
    "source_segment": 7,
    "start": 129.695819,
    "end": 132.737573,
    "text": "本可以告警、冻结钱包签名权限，",
    "start_ms": 129696,
    "end_ms": 132738
  },
  {
    "scene": 4,
    "source_segment": 8,
    "start": 132.737573,
    "end": 133.7812465,
    "text": "却没有拦住。",
    "start_ms": 132738,
    "end_ms": 133781
  },
  {
    "scene": 4,
    "source_segment": 9,
    "start": 133.7812465,
    "end": 137.38789,
    "text": "监控盯住了余额，却没盯住代码改写。",
    "start_ms": 133781,
    "end_ms": 137388
  },
  {
    "scene": 4,
    "source_segment": 10,
    "start": 137.38789,
    "end": 139.9134005,
    "text": "转账数组是64种代币，",
    "start_ms": 137388,
    "end_ms": 139913
  },
  {
    "scene": 4,
    "source_segment": 11,
    "start": 139.9134005,
    "end": 142.731046,
    "text": "加一个以太币占位，共65项。",
    "start_ms": 139913,
    "end_ms": 142731
  },
  {
    "scene": 5,
    "source_segment": 0,
    "start": 143.73,
    "end": 147.59,
    "text": "50条授权，按nonce降序排，起止值见标尺。",
    "start_ms": 143730,
    "end_ms": 147590
  },
  {
    "scene": 5,
    "source_segment": 1,
    "start": 147.81183099999998,
    "end": 150.97183099999998,
    "text": "nonce须等于账户当前值，不等就跳过。",
    "start_ms": 147812,
    "end_ms": 150972
  },
  {
    "scene": 5,
    "source_segment": 2,
    "start": 151.25654,
    "end": 155.27653999999998,
    "text": "前15条过高；一条命中，代码写入、nonce加一；",
    "start_ms": 151257,
    "end_ms": 155277
  },
  {
    "scene": 5,
    "source_segment": 3,
    "start": 155.441434,
    "end": 159.4059515,
    "text": "余下34条过低。若改升序，就会连续生效、",
    "start_ms": 155441,
    "end_ms": 159406
  },
  {
    "scene": 5,
    "source_segment": 4,
    "start": 159.4059515,
    "end": 162.270469,
    "text": "连推16次，扰乱热钱包队列。",
    "start_ms": 159406,
    "end_ms": 162270
  },
  {
    "scene": 5,
    "source_segment": 5,
    "start": 162.40202299999999,
    "end": 165.3341045,
    "text": "预签50个nonce，也针对取消动作：",
    "start_ms": 162402,
    "end_ms": 165334
  },
  {
    "scene": 5,
    "source_segment": 6,
    "start": 165.3341045,
    "end": 168.554666,
    "text": "自转交易用掉当前nonce，只废一张，",
    "start_ms": 165334,
    "end_ms": 168555
  },
  {
    "scene": 5,
    "source_segment": 7,
    "start": 168.554666,
    "end": 170.623146,
    "text": "剩下49张仍有效。",
    "start_ms": 168555,
    "end_ms": 170623
  },
  {
    "scene": 5,
    "source_segment": 8,
    "start": 170.757576,
    "end": 173.41443149999998,
    "text": "所以nonce喷洒不是为提高命中率，",
    "start_ms": 170758,
    "end_ms": 173414
  },
  {
    "scene": 5,
    "source_segment": 9,
    "start": 173.41443149999998,
    "end": 176.111287,
    "text": "而是让单次取消失去意义。",
    "start_ms": 173414,
    "end_ms": 176111
  },
  {
    "scene": 6,
    "source_segment": 0,
    "start": 177.063333,
    "end": 182.783333,
    "text": "50条授权，每条25,000 gas，\n唯一命中退12,500，再加21,000和62，",
    "start_ms": 177063,
    "end_ms": 182783
  },
  {
    "scene": 6,
    "source_segment": 0,
    "start": 183.08333299999998,
    "end": 187.563333,
    "text": "共1,258,562 gas。49条诱饵照付。",
    "start_ms": 183083,
    "end_ms": 187563
  },
  {
    "scene": 6,
    "source_segment": 1,
    "start": 187.867403,
    "end": 192.107403,
    "text": "以太坊上约25亿美元的清空，只花约0.91美元。",
    "start_ms": 187867,
    "end_ms": 192107
  },
  {
    "scene": 6,
    "source_segment": 2,
    "start": 192.137544,
    "end": 194.417544,
    "text": "以太币用量逐位读为：",
    "start_ms": 192138,
    "end_ms": 194418
  },
  {
    "scene": 6,
    "source_segment": 2,
    "start": 194.657544,
    "end": 199.197544,
    "text": "0.000414。比率约1:27亿。",
    "start_ms": 194658,
    "end_ms": 199198
  },
  {
    "scene": 7,
    "source_segment": 0,
    "start": 200.39666699999998,
    "end": 201.73,
    "text": "发行方黑名单冻结了：",
    "start_ms": 200397,
    "end_ms": 201730
  },
  {
    "scene": 7,
    "source_segment": 1,
    "start": 201.73,
    "end": 203.35999999999999,
    "text": "Tether 15.67亿、",
    "start_ms": 201730,
    "end_ms": 203360
  },
  {
    "scene": 7,
    "source_segment": 2,
    "start": 203.35999999999999,
    "end": 204.73,
    "text": "Circle 8.23亿、",
    "start_ms": 203360,
    "end_ms": 204730
  },
  {
    "scene": 7,
    "source_segment": 3,
    "start": 204.73,
    "end": 205.633333,
    "text": "Ripple 2亿、",
    "start_ms": 204730,
    "end_ms": 205633
  },
  {
    "scene": 7,
    "source_segment": 4,
    "start": 205.633333,
    "end": 207.748333,
    "text": "USD1 2700万美元。",
    "start_ms": 205633,
    "end_ms": 207748
  },
  {
    "scene": 7,
    "source_segment": 5,
    "start": 207.748333,
    "end": 209.72666649999996,
    "text": "合计约26.2亿，",
    "start_ms": 207748,
    "end_ms": 209727
  },
  {
    "scene": 7,
    "source_segment": 6,
    "start": 209.72666649999996,
    "end": 211.5,
    "text": "占外流约46%。",
    "start_ms": 209727,
    "end_ms": 211500
  },
  {
    "scene": 7,
    "source_segment": 7,
    "start": 211.886667,
    "end": 214.3633335,
    "text": "这依赖资产构成，不是风控能力。",
    "start_ms": 211887,
    "end_ms": 214363
  },
  {
    "scene": 7,
    "source_segment": 8,
    "start": 214.3633335,
    "end": 215.76833349999998,
    "text": "稳定币能冻结，",
    "start_ms": 214363,
    "end_ms": 215768
  },
  {
    "scene": 7,
    "source_segment": 9,
    "start": 215.76833349999998,
    "end": 216.7933335,
    "text": "原生比特币、",
    "start_ms": 215768,
    "end_ms": 216793
  },
  {
    "scene": 7,
    "source_segment": 10,
    "start": 216.7933335,
    "end": 217.6333335,
    "text": "以太币不能。",
    "start_ms": 216793,
    "end_ms": 217633
  },
  {
    "scene": 7,
    "source_segment": 11,
    "start": 217.6333335,
    "end": 220.58499999999998,
    "text": "攻击者正把PEPE、UNI、LINK",
    "start_ms": 217633,
    "end_ms": 220585
  },
  {
    "scene": 7,
    "source_segment": 12,
    "start": 220.58499999999998,
    "end": 221.675,
    "text": "卖成以太币，",
    "start_ms": 220585,
    "end_ms": 221675
  },
  {
    "scene": 7,
    "source_segment": 13,
    "start": 221.675,
    "end": 223.356667,
    "text": "转向冻不了的资产。",
    "start_ms": 221675,
    "end_ms": 223357
  },
  {
    "scene": 8,
    "source_segment": 0,
    "start": 225.39666699999998,
    "end": 228.396667,
    "text": "10月30日凌晨，根因仍未经官方确认，",
    "start_ms": 225397,
    "end_ms": 228397
  },
  {
    "scene": 8,
    "source_segment": 0,
    "start": 228.636667,
    "end": 231.556667,
    "text": "私钥泄露或签名系统被利用，都只是假设。",
    "start_ms": 228637,
    "end_ms": 231557
  },
  {
    "scene": 8,
    "source_segment": 1,
    "start": 231.662296,
    "end": 234.782296,
    "text": "盯三个信号：官方公告、储备证明更新、",
    "start_ms": 231662,
    "end_ms": 234782
  },
  {
    "scene": 8,
    "source_segment": 1,
    "start": 235.102296,
    "end": 237.762296,
    "text": "币安14号钱包的零地址撤销授权。",
    "start_ms": 235102,
    "end_ms": 237762
  },
  {
    "scene": 8,
    "source_segment": 2,
    "start": 237.954367,
    "end": 241.094367,
    "text": "三个都未出现，后门可能只是暂时没人用。",
    "start_ms": 237954,
    "end_ms": 241094
  }
]
